# Telegram bot tokenini @BotFather orqali oling
TELEGRAM_BOT_TOKEN=8856627501:AAGDeuZJGbHLg3tKWxeyStyHnnRoQKxttIw

# 1-AI (asosiy): Google Gemini — BEPUL: https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6Je6f1GqRdxiDGWhli9NmfC7J_DiH9ycR66ATw1YAz6mw

# 2-AI (zaxira): Groq — BEPUL: https://console.groq.com/keys
# Ixtiyoriy, lekin tavsiya etiladi.
GROQ_API_KEY=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

# 3-AI (yana zaxira): OpenRouter — BEPUL: https://openrouter.ai/keys
# Ixtiyoriy. Uchtasi ham qo'shilsa, tizim deyarli hech qachon to'xtamaydi.
OPENROUTER_API_KEY=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

# Ixtiyoriy AI sozlamalari
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=openrouter/free
# Ovozli xabar (Whisper) uchun Groq modeli
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Uskunalar va texnik sozlamalar
LINES_CONFIG_PATH=lines.json
QUERY_LOG_PATH=queries.log
PERSISTENCE_PATH=bot_state.pickle
MAX_CANDIDATE_TAGS=25
CACHE_PATH=answer_cache.json
CACHE_TTL_HOURS=72
MIN_LOCAL_CANDIDATES=3

# --- Foydalanuvchi boshiga so'rov chegarasi ---
RATE_LIMIT_PER_MIN=3
RATE_LIMIT_PER_DAY=30

# --- Kirishni cheklash (ixtiyoriy) ---
# Bo'sh qoldirilsa, bot HAMMAGA OCHIQ bo'ladi (standart holat).
# To'ldirilsa, faqat shu ID'lar (va ular /adduser yoki /register orqali
# qo'shgan/tasdiqlagan odamlar) botdan foydalana oladi. O'z Telegram
# ID'ingizni bilish uchun @userinfobot'ga yozing.
ADMIN_USER_IDS=1047268578
ALLOWED_USERS_PATH=allowed_users.json
PENDING_REG_PATH=pending_registrations.json

# --- Haftalik statistika hisoboti qayerga yuborilsin (ixtiyoriy) ---
STATS_CHAT_ID=1047268578

# --- Ma'lumot sifati: mos kelmagan so'rovlar shu faylga yoziladi ---
NO_MATCH_LOG_PATH=no_match.log

# --- Bot salomatligini kuzatish (ixtiyoriy) ---
# https://healthchecks.io saytida bepul "check" yarating va ping URL'ni bu yerga qo'ying.
HEALTHCHECK_PING_URL=
HEALTHCHECK_INTERVAL_MIN=5

# --- ESP32 zavod monitoring integratsiyasi (ixtiyoriy) ---
# ESP32'dagi yangi /status endpoint manzili, masalan:
# ESP32_STATUS_URL=http://192.168.1.50/status
# (ESP32'ning mahalliy IP-manzilini Serial Monitor'dan bilib olishingiz mumkin,
# ishga tushganda "Status-server ishga tushdi: http://..." deb chiqadi)
ESP32_STATUS_URL=
ESP32_TIMEOUT_SEC=5

# --- Log arxivlash va zaxira nusxa ---
BACKUP_DIR=backups
BACKUP_KEEP=14

# --- Elektr sxemasi (ixtiyoriy) ---
# Bitta so'rovda eng ko'p nechta sxema sahifasi yuborilsin
MAX_SCHEMATIC_PAGES=3

# --- Kutubxona/Qo'llanma (ixtiyoriy) ---
# Bitta qidiruvda eng ko'p nechta qo'llanma sahifasi yuborilsin
MAX_LIBRARY_RESULTS=3
