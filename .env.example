GROQ_API_KEY=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

# 3-AI (yana zaxira): OpenRouter — BEPUL: https://openrouter.ai/keys
