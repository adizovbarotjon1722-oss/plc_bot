# --- Ma'lumot sifati: mos kelmagan so'rovlar shu faylga yoziladi ---
NO_MATCH_LOG_PATH=no_match.log

# --- Bot salomatligini kuzatish (ixtiyoriy) ---
# https://healthchecks.io saytida bepul "check" yarating va ping URL'ni bu yerga qo'ying.
HEALTHCHECK_PING_URL=
HEALTHCHECK_INTERVAL_MIN=5
